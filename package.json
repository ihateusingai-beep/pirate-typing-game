{
  "name": "pirate-typing-game",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "海盜船長炮台：Pirate Captain's Cannon — Keyboard learning game for primary school",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
